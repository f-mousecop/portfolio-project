---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import AccordionComponent from '../components/Accordion.astro';
import { Accordion, AccordionItem } from 'accessible-astro-components';

const contactInfo = [
    { iconName: 'mdi:email',  iconAlign: 'start', iconPosition: 'top', iconSize: '2.5rem', heading: 'Email:', body: 'charles@builtbyclark.dev' },
    { iconName: 'mdi:phone',  iconAlign: 'start', iconPosition: 'top', iconSize: '2.5rem', heading: 'Phone:', body: '(555) 555-5555' },
    { iconName: 'mdi:web',    iconAlign: 'start', iconPosition: 'top', iconSize: '2.5rem', heading: 'Website:', body: 'https://builtbyclark.dev' },
    { iconName: 'mdi:map-marker',  iconAlign: 'start', iconPosition: 'top', iconSize: '2.5rem', heading: 'Location:', body: 'City, State, Country' }
] as const;
---

<Layout title="Contact" description="Contact page for Charles Clark Studio" pageTitle="Contact">
    <div class="container contact-info">
        <h2>Ready to Get Started?</h2>
        <div class="contact-cards">
            {contactInfo.map((info) => (
                <Card 
                    icon={info.iconName} 
                    iconAlign={info.iconAlign} 
                    iconPosition={info.iconPosition} 
                    iconSize={info.iconSize}
                    marginBottom="1rem"
                >
                    <h3>{info.heading}</h3>
                    <p>{info.body}</p>
                </Card>
            ))}
        </div>

        
    </div>
    <div style="background-color: var(--color-primary); padding: 1rem;">
            <hr class="container" style="border: 1px solid var(--color-accent); border-radius: var(--radius-md);">
    </div>
    <section id="faq">
        <div class="container faq">
            <h2>Frequently Asked Questions</h2>
            <Accordion>
                <AccordionItem
                    name="projects"
                    title="What type of projects do I work on?"
                    open
                >
                    <p>I work on responsive websites, mobile applications (Android for now), and desktop applications.</p>
                </AccordionItem>
            </Accordion>

            <AccordionComponent title="What services do you offer?">
                <p>We offer a wide range of services including web development, design, and consulting.</p>
            </AccordionComponent>
            <AccordionComponent title="How can I get in touch?">
                <p>You can reach us via email at charles@builtbyclark.dev</p>
            </AccordionComponent>
        </div>
    </section>
</Layout>

<style>
    .contact-info {
        padding-top: 2rem;
        padding-bottom: 2rem;
    }

    .contact-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
    }

</style>