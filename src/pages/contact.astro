---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const contactInfo = [
    { iconName: 'mdi:email',  iconAlign: 'start', iconPosition: 'top', iconSize: '2.5rem', heading: 'Email:', body: 'charles@builtbyclark.dev' },
    { iconName: 'mdi:phone',  iconAlign: 'start', iconPosition: 'top', iconSize: '2.5rem', heading: 'Phone:', body: '(555) 555-5555' },
    { iconName: 'mdi:web',    iconAlign: 'start', iconPosition: 'top', iconSize: '2.5rem', heading: 'Website:', body: 'https://builtbyclark.dev' },
    { iconName: 'mdi:map-marker',  iconAlign: 'start', iconPosition: 'top', iconSize: '2.5rem', heading: 'Location:', body: 'City, State, Country' }
]
---

<Layout title="Contact" description="Contact page for Charles Clark Studio" pageTitle="Contact">
    <div class="container contact-info">
        <h2>Ready to Get Started?</h2>
        <div class="contact-cards">
            {contactInfo.map((info) => (
                <Card 
                    icon={info.iconName} 
                    iconAlign={info.iconAlign} 
                    iconPosition={info.iconPosition} 
                    iconSize={info.iconSize}
                    marginBottom="1rem"
                >
                    <h3>{info.heading}</h3>
                    <p>{info.body}</p>
                </Card>
            ))}
        </div>

        
    </div>
    <div style="background-color: var(--color-primary); padding: 1rem;">
            <hr class="container" style="border: 1px solid var(--color-accent); border-radius: var(--radius-md);">
    </div>
</Layout>

<style>
    .contact-info {
        padding-top: 2rem;
        padding-bottom: 2rem;
    }

    .contact-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
    }
</style>