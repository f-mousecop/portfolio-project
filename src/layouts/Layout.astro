---
import "../styles/global.css";
import Header from "../components/Header.astro";
import MainBackground from "../components/MainBackground.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const {
	title,
	description = "Charles Clark Studio — software and web development."
} = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/light-icon.png" />
		<link rel="icon" href="/light-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap"
            rel="stylesheet"
        />
		<title>{title}</title>

		<ClientRouter />
	</head>
	<body>
		<Header />
		<MainBackground />
		<slot />
	</body>
</html>
