---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MainBackground from "../components/MainBackground.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	pageTitle?: string | undefined;
}

const {
	title,
	description = "Charles Clark Studio — software and web development.",
	pageTitle
} = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/light-icon.png" />
		<link rel="icon" href="/light-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap"
            rel="stylesheet"
        />
		<title>{title}</title>

		<ClientRouter />
	</head>
	<body>
		<Header />
		<div class="banner">
			<div class="container title"><h2>{pageTitle}</h2></div>
		</div>
		<MainBackground />
		<slot />
		<Footer />
	</body>
</html>

<style>
	.banner {
		display: flex;
		align-items: center;
        min-height: 48.79px;
        background-color: var(--color-secondary);
    }

	.title h2 {
		margin-bottom: 0;
		padding: 0.5rem 0;
		color: var(--color-surface);
		text-transform: uppercase;
		font-size: 1.5rem;
		font-weight: var(--font-medium);
	}
</style>
