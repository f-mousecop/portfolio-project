---
import { Icon } from 'astro-icon/components'

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
    { label: 'Home', href: '/' },
    { label: 'Work', href: '/work' },
    { label: 'About', href: '/about' },
    { label: 'Contact', href: '/contact' }
];

const iconLinks: { label: string; href: string; target: string; icon: string }[] = [
    { label: 'GitHub', href: 'https://github.com/f-mousecop', target: '_blank', icon: 'mdi:github' },
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/charles-clark-261b13284/', target: '_blank', icon: 'mdi:linkedin' }
]

/** Test if a link is pointing to the current page */
const isCurrentPage = (href: string) => {
    let pathName = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
    if (pathName.at(0) !== '/') pathName = '/' + pathName;
    if (pathName.at(-1) !== '/') pathName += '/';
    return pathName === href || (href !== '/' && pathName.startsWith(href));
};
---

<nav>
    <div class="primary-menu">
        <ul class="nav-items">
            {
                textLinks.map(({ label, href }) => (
                    <li>
                        <a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>{label}</a>
                    </li>
                ))
            }
        </ul>
        <ul class="nav-icons">
            {
                iconLinks.map(({ label, href, target, icon }) => (
                    <li>
                        <a aria-label={label} class="link" href={href} target={target}>
                            <Icon name={icon} />
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>

<style>
    nav {
        font-family: var(--font-heading);
    }

    .primary-menu {
        display: flex;
        justify-content: space-between;
        gap: 3rem;
        align-items: center;
    }

    .nav-items {
        display: flex;
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
        color: var(--color-background);
        text-transform: uppercase;
    }

    .nav-icons {
        display: flex;
        gap: 1rem;
        list-style: none;
        font-size: 2rem;
        margin: 0;
        padding: 0;
        color: var(--color-background);
    }

    .link {
        text-decoration: none;
        color: inherit;
    }

    .link[aria-current="page"] {
        color: var(--color-highlight);
        font-weight: bold;
    }

    @media (max-width: 768px) {
        .primary-menu {
            display: block;
        }

        .primary-menu li {
            /* border-bottom: 2px solid var(--color-accent); */
        }

        .nav-items {
            flex-direction: column;
            padding-top: 2rem;
            font-size: var(--text-lg);
            color: var(--color-primary);
        }

        .nav-items li {
            border-bottom: 2px solid var(--color-accent);
        }

        .nav-items li:last-child {
            margin-bottom: 1.5rem;
        }

        .nav-icons {
            font-size: 2.5rem;
            color: var(--color-primary);
        }
    }

</style>