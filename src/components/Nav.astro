---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import { Image } from 'astro:assets';
import lightLogo from "../assets/Light-logo.svg";

/** Determine whether to show logo */
interface Props {
    showLogo?: boolean;
}

const { showLogo = true } = Astro.props;


/** Main menu items */
const textLinks: { label: string; href: string }[] = [
    { label: 'Home', href: '/' },
    { label: 'Work', href: '/work' },
    { label: 'About', href: '/about' },
    { label: 'Contact', href: '/contact' }
];

const iconLinks: { label: string; href: string; target: string; icon: string }[] = [
    { label: 'GitHub', href: 'https://github.com/f-mousecop', target: '_blank', icon: 'mdi:github' },
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/charles-clark-261b13284/', target: '_blank', icon: 'mdi:linkedin' }
]

/** Test if a link is pointing to the current page */
const isCurrentPage = (href: string) => {
    let pathName = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
    if (pathName.at(0) !== '/') pathName = '/' + pathName;
    if (pathName.at(-1) !== '/') pathName += '/';
    return pathName === href || (href !== '/' && pathName.startsWith(href));
};
---

<nav class="site-nav" aria-label="Primary navigation">

    {showLogo && (
        <div class="logo-container">
            <Logo />
        </div>
    )}

    <ul class="nav-items">
        {
            textLinks.map(({ label, href }) => (
                <li>
                    <a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>{label}</a>
                </li>
            ))
        }
    </ul>
    <ul class="nav-icons">
        {
            iconLinks.map(({ label, href, target, icon }) => (
                <li>
                    <a aria-label={label} class="link" href={href} target={target}>
                        <Icon name={icon} />
                    </a>
                   </li>
            ))
        }
    </ul>
</nav>

<style>
    nav {
        font-family: var(--font-heading);
    }

    .site-nav {
        display: flex;
        justify-content: space-between;
        gap: 3rem;
        align-items: center;
    }

    .nav-items {
        display: flex;
        gap: 0.2rem;
        list-style: none;
        margin: 0;
        padding: 0.4rem 0.4rem;
        color: var(--color-background);
        text-transform: uppercase;

        background-color: var(--color-secondary);
        border-bottom: 1px solid var(--color-accent);
        border-radius: 999rem;
    }

    .nav-items .link {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-sm);

        padding: 0.2rem 0.65rem;
        border-radius: 999rem;
    }

    .nav-icons {
        display: flex;
        gap: 1rem;
        list-style: none;
        font-size: 2rem;
        margin: 0;
        padding: 0;
        color: var(--color-background);
    }

    .link {
        text-decoration: none;
        color: inherit;
        transition:
            color var(--transition-default),
            background-color var(--transition-default);
    }

    .link[aria-current="page"] {
        color: var(--color-highlight);
        font-weight: bold;
        
        background-color: color-mix(
            in srgb,
            var(--color-secondary) 75%,
            var(--color-accent) 25%
        );

        box-shadow: 
            inset 0 2px 5px rgba(0, 0, 0, 0.4),
            inset 0 0 0 2px var(--color-accent);
    }

    .link:hover,
    .link:focus {
        color: var(--color-text-muted);
        background-color: var(--accent-subtle-overlay);
    }

    @media (max-width: 768px) {
        .site-nav {
            display: block;
        }

        .nav-items {
            flex-direction: column;
            padding-top: 2rem;
            color: var(--color-primary);
            gap: 1rem;

            background-color: transparent;
            border: none;
            border-radius: 0;
        }

        .nav-items li {
            border-bottom: 2px solid var(--color-accent);
        }

        .nav-items .link {
            justify-content: start;
            font-size: var(--text-lg);
            padding: 0;
            background: none;
            box-shadow: none;
        }

        .nav-items li:last-child {
            margin-bottom: 1.5rem;
        }

        .nav-icons {
            font-size: 2.5rem;
            color: var(--color-primary);
        }
    }

</style>