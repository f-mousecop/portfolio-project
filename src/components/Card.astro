---
import { Icon } from 'astro-icon/components';

export interface Props {
    dark?: boolean;
    maxHeight?: string;
    marginBottom?: string;
    backgroundColor?: string;

    icon?: string;
    iconPosition?: 'top' | 'start' | 'end';
    iconAlign?: 'start' | 'center' | 'end';
    iconSize?: string;
    iconColor?: string;
}

const { 
    dark = false, 
    maxHeight, marginBottom = "0", 
    backgroundColor = "var(--color-surface)",
    icon,
    iconPosition = 'top',
    iconAlign = 'center',
    iconSize = '2.5rem',
    iconColor = 'var(--color-accent)'
} = Astro.props;
---

<div 
    class:list={[
        'card',
        { dark },
        { 'has-icon': icon }
    ]}
    data-icon-position={iconPosition}
    data-icon-align={iconAlign}>
    {
        icon && (
            <div class="card-icon">
                <Icon name={icon} />
            </div>
        )
    }

    <div class="content">
        <slot />
    </div>
</div>


<style define:vars={{maxHeight, marginBottom, backgroundColor, iconSize, iconColor}}>
    .card {
        display: flex;
        gap: 1rem;
        background: var(--backgroundColor);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        margin-bottom: var(--marginBottom);
        padding: 1rem;
        height: 100%;
        transition: 
            transform 0.5s ease,
            box-shadow 0.5s ease;
        will-change: transform;
    }

    .card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .dark {
        background: var(--color-secondary);
        color: var(--color-background);
    }

    .content {
        flex: 1;
        min-width: 0;
    }

    /* -------------------------
        Icon
    ---------------------------- */

    .card-icon {
        display: flex;
        flex-shrink: 0;

        color: var(--iconColor);
    }

    .card-icon :global(svg) {
        width: var(--iconSize);
        height: var(--iconSize);
        color: var(--iconColor);
    }

    /* Top */

    .card[data-icon-position="top"] {
        flex-direction: column;
    }

    /* Start / left */
    
    .card[data-icon-position="start"] {
        flex-direction: row;
    }

    /* End */

    .card[data-icon-position="end"] {
        flex-direction: row-reverse;
    }

    /* Alignment */

    .card[data-icon-align="start"] .card-icon {
        align-self: flex-start;
    }

    .card[data-icon-align="center"] .card-icon {
        align-self: center;
    }

    .card[data-icon-align="end"] .card-icon {
        align-self: flex-end;
    }

    @media (max-width: 768px) {
        .card {
            max-height: var(--maxHeight);
            overflow: auto;
        }
    }
</style>