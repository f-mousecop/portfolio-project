---

---

<div class="hello-code-window">
    <div class="hello-titlebar">
        <div class="hello-controls" aria-hidden="true">
            <span class="control close"></span>
            <span class="control minimize"></span>
            <span class="control maximize"></span>
        </div>

        <span class="hello-filename">hello-world.py</span>

        <span class="hello-title-spacer" aria-hidden="true"></span>
    </div>

    <div class="hello-editor">
        <pre><code><span class="code-function">print</span><span class="code-punctuation">(</span><span class="code-string">"Hello, World!"</span><span class="code-punctuation">)</span></code></pre>
    </div>

    <div class="hello-terminal">
        <div class="terminal-heading">TERMINAL</div>

        <pre><code><span class="terminal-prompt">$</span> python hello_world.py
<span class="terminal-output">Hello, World!</span>

<span class="terminal-comment"># The first step in building something new.</span></code></pre>
    </div>
</div>

<style>
    .hello-code-window {
        width: 100%;
        max-width: 100%;
        overflow: hidden;
        background: #142b3d;
        border: 1px solid rgba(246, 248, 250, 0.14);
        border-radius: 12px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
    }

    /* Title bar */

    .hello-titlebar {
        min-height: 42px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 14px;
        background: #0f2230;
        border-bottom: 1px solid rgba(246, 248, 250, 0.1);
    }

    .hello-controls {
        display: flex;
        gap: 7px;
        justify-self: start;
    }

    .control {
        width: 11px;
        height: 11px;
        display: block;
        border-radius: 50%;
    }

    .control.close {
        background: #ff5f57;
    }

    .control.minimize {
        background: #febc2e;
    }

    .control.maximize {
        background: #28c840;
    }

    .hello-filename {
        color: #cfd8df;
        font-family: "Space Grotesk", sans-serif;
        font-size: 13px;
        font-weight: 500;
    }

    .hello-title-spacer {
        width: 43px;
        justify-self: end;
    }

    /* Code editor */

    .hello-editor {
        padding: 28px 24px;
        background: #142b3d;
    }

    .hello-code-window pre {
        margin: 0;
        overflow-x: auto;
        color: #e6edf3;
        font-family: "JetBrains Mono", "Source Code Pro", Consolas, monospace;
        font-size: 15px;
        line-height: 1.75;
        tab-size: 4;
    }

    .hello-code-window code {
        font-family: inherit;
    }

    /* Manual syntax highlighting */

    .code-keyword {
        color: #c792ea;
    }

    .code-function {
        color: #82aaff;
    }

    .code-string {
        color: #c3e88d;
    }

    .code-punctuation {
        color: #89ddff;
    }

    /* Terminal area */

    .hello-terminal {
        padding: 14px 24px 22px;
        background: #0b1d29;
        border-top: 1px solid rgba(246, 248, 250, 0.14);
    }

    .terminal-heading {
        margin-bottom: 12px;
        color: #94a3ae;
        font-family: "Space Grotesk", sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.12em;
    }

    .hello-terminal pre {
        font-size: 13px;
        line-height: 1.65;
    }

    .terminal-prompt {
        color: #82aaff;
    }

    .terminal-output {
        color: #f6f8fa;
    }

    .terminal-comment {
        color: #8495a1;
    }

    /* Tablet and mobile */

    @media (max-width: 767px) {
        .hello-code-window {
            max-width: 100%;
        }

        .hello-editor {
            padding: 22px 18px;
        }

        .hello-terminal {
            padding: 14px 18px 20px;
        }

        .hello-code-window pre {
            font-size: 13px;
        }

        .hello-terminal pre {
            font-size: 12px;
        }
    }
</style>
