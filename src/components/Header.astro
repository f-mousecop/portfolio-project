---
import { Image } from "astro:assets";
import darkLogo from "../assets/Dark-logo.svg";
import lightLogo from "../assets/Light-logo.svg";
import Nav from "./Nav.astro";
import MobileMenu from "./MobileMenu.astro";
import { Icon } from 'astro-icon/components'
---

<header class="header" role="banner">
    <h2 class="sr-only">Header</h2>
    <div class="container">
        <div class="logo-contianer">
            <a href="/">
                <Image 
                       src={lightLogo}
                       alt="Go to Charles Clark Studio home"
                    priority
                    class="logo"
                />
            </a>
        </div>

        <nav class="desktop-only">
            <Nav />
        </nav>

        <Icon name="mdi:hamburger-menu" id="menu-toggle" aria-label="Toggle Menu" class="mobile-only" />

        <MobileMenu />
    </div>     
</header>

<script>
    // Need to ensure script runs after client-side navigation using Astro transitions
    document.addEventListener('astro:page-load', () => {
        console.log('Page has loaded');
        const toggleBtn = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
    
        const getIsMobileMenuOpen = () => mobileMenu?.classList.contains('open');
        
        toggleBtn?.addEventListener('click', () => {
            mobileMenu?.classList.toggle('open');
            console.log(getIsMobileMenuOpen());
        });

        function closeMobileMenu(event: Event) {
            if (!getIsMobileMenuOpen()) {
                console.log("Menu is already closed");
                return;
            }
    
            if (mobileMenu && !mobileMenu?.contains(event.target as Node) && !toggleBtn?.contains(event.target as Node)) {
                mobileMenu?.classList.remove('open');
                console.log("Clicked outside mobile menu, closing it");
            }
        }
        
        document.addEventListener('click', closeMobileMenu);
    
        const mediaQuery = window.matchMedia('(min-width: 769px)');
        function handleMediaQueryChange(event: MediaQueryListEvent) {
    
            if (event.matches && getIsMobileMenuOpen()) {
                mobileMenu?.classList.remove('open');
                console.log("Viewport is now wider than 1024px, closing mobile menu");
            }
        }
        mediaQuery.addEventListener('change', handleMediaQueryChange);
    });
    
</script>

<style>
    .header {
        position: sticky;
        top: 0;
        box-shadow: none;
        background-color: var(--color-primary);
    }

    .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
    }

    .logo-container {
        vertical-align: middle;
        display: flex;
    }

    .desktop-only {
        display: flex;
    }

    .mobile-only {
        display: none;
        background: none;
        border: none;
        font-size: 2.5em;
        color: var(--color-accent);
    }

    /* .bar {
        width: 30px;
        height: 4px;
        background-color: var(--color-accent);
        margin: 5px 0;
        transition: all 0.5s ease;
        position: relative;
        border-radius: 1rem;
        transform-origin: center;
    } */

    @media (max-width: 768px) {
        .desktop-only {
            display: none;
        }

        .mobile-only {
            display: block;
        }
    }
</style>