---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import WorkspaceImage from "../assets/home_workspace_orig_edit.jpg";
import HeroImage from "../assets/home-hero-img.jpg";
import CardAstroComponent from "./Card.astro";
import ProjectCardAstroComponent from "./ProjectCard.astro";

import MerchToolsLogo from "../assets/ic_launcher-playstore.png";
import CBSHomeScreen from "../assets/cbs-home-ss.png";
import ChatAppLogin from "../assets/chatapp-login-ss.png";
import WorkImage from "../assets/work-image.jpg";

import CodeWindowWidget from "./CodeWindowWidget.astro";
---

<div class="banner"></div>

<section id="hero" class="hero">
    <div class="container hero-inner">
        <div class="hero-text">
            <h2 class="eyebrow">Practical software for real-world work.</h2>
            <h1>Thoughtful software, built with purpose.</h1>
            <p>An independent development studio focused on creating useful, intuitive digital solutions.</p>
    
               <div class="hero-ctas">
                <a class="button" href="/work">View My Work</a>
                <a class="button secondary" href="/contact">Get Started</a>
            </div>
        </div>

        <div class="hero-img">
            <Image src={HeroImage} alt="Artist picture of computer and keyboard" layout="constrained" width={800} height={600} />
        </div>
    </div>
</section>

<div class="container">
    <section id="introduction" class="introduction">
        <div class="intro-img">
            <Image src={WorkspaceImage} alt="Home workspace image with two monitors and a keyboard and mouse" layout="constrained" width={600} height={400} />
        </div>

        <div class="intro-text">
            <h2>Building software that solves real problems.</h2>
            <p>Charles Clark Studio is a place where I can showcase my projects and the work I’ve completed for others. Beyond a portfolio, it’s an entry point for developing the solutions you need—whether mobile, desktop, or web.</p>

            <div>
                <a class="button" href="/about">About The Studio</a>
            </div>

        </div>
    </section>
</div>

<section id="what-i-do">
    <div class="container">
        <h2 style="color: var(--color-surface); text-align: center;">What I Do</h2>

        <hr style="border: 2px solid var(--color-highlight); margin-bottom: 1rem; border-radius: var(--radius-md);">
        
        <hr style="border: 1px solid var(--color-accent); border-radius: var(--radius-md);">
        <hr style="border: 1px solid var(--color-accent); border-radius: var(--radius-md);">


        <div class="work-cards">
            <CardAstroComponent
                icon="mdi:mobile-phone-text"
                iconPosition="start"
                iconAlign="start"
                iconColor="var(--color-highlight)"
                iconSize="3.5rem"
                backgroundColor="var(--color-text-muted)"
            >
                <h3>Mobile Apps</h3>
                <p>Android applications built around practical use cases, including tools for retail auditing and inventory management.</p>
            </CardAstroComponent>

            <CardAstroComponent
                icon="mdi:desktop-classic"
                iconPosition="start"
                iconAlign="start"
                iconColor="var(--color-primary)"
                iconSize="3.5rem"
                backgroundColor="var(--color-accent)"
            >
                <h3>Desktop Apps</h3>
                <p>Desktop tools and standalone applications designed around requirements and intuitive user experiences.</p>
            </CardAstroComponent>

            <CardAstroComponent
                icon="mdi:code-block-tags"
                iconPosition="start"
                iconAlign="start"
                iconColor="var(--color-highlight)"
                iconSize="3.5rem"
                backgroundColor="var(--color-text-muted)"
            >
                <h3>Web Development</h3>
                <p>Responsive websites and web experiences designed around usability, accessibility, and the needs of the people using them.</p>
            </CardAstroComponent>
        </div>

        <hr style="border: 1px solid var(--color-accent); border-radius: var(--radius-md);">
        <hr style="border: 1px solid var(--color-accent); border-radius: var(--radius-md);">
    </div>
</section>

<section id="featured-work">
    <div class="container featured-work">
        <h2>Featured Work</h2>
        <hr style="border: 2px solid var(--color-accent); border-radius: var(--radius-md);">

        <h3>A selection of projects across mobile, desktop, and web development.</h3>

        <div class="featured-work-cards">
            <ProjectCardAstroComponent 
                image={MerchToolsLogo}
                alt="MerchTools logo"
                title="MerchTools"
                description="A mobile shelf-audit and inventory tool designed for retail workflows."
                backgroundColor="var(--color-text)"
                href="/work"
            >
                <CodeWindowWidget 
                    platform="Android"
                    lang="Kotlin"
                    framework="Jetpack Compose" 
                />
            </ProjectCardAstroComponent>

            <ProjectCardAstroComponent 
                image={ChatAppLogin}
                alt="ChatApp login screen"
                title="ChatApp"
                description="A desktop application providing real-time AI chatbot features."
                backgroundColor="var(--color-text)"
                href="/work"
            >
                <CodeWindowWidget 
                    platform="Windows"
                    lang="C#"
                    framework=".NET" 
                />
            </ProjectCardAstroComponent>

            <ProjectCardAstroComponent 
                image={CBSHomeScreen}
                alt="Complete Benefit Solutions home screen"
                title="Complete Benefit Solutions"
                description="A responsive website connecting people with the insurance they need."
                backgroundColor="var(--color-text)"
                href="/work"
            >
                <CodeWindowWidget
                    platform="Web"
                    lang="AstroJS"
                    framework="React" 
                />
            </ProjectCardAstroComponent>

        </div>

        <hr style="border: 2px solid var(--color-accent); border-radius: var(--radius-md);">
        <a href="/work" class="button" style="font-size: var(--text-base); height: 50px; width: 300px;">View All Projects</a>

    </div>
</section>

<section id="call-to-action">
    <div class="container call-to-action">
        <div class="left-column">
            <h2>Have something you'd like to build?</h2>
            <hr style="border: 1px solid var(--color-accent); border-radius: var(--radius-md);">

            <p>Feel free to reach out during my normal business hours and I will respond within one business day:</p>
            <ul>
                <li>Monday — Friday: 9 AM — 5 PM</li>
            </ul>

            <div class="cta-button">
                <a href="/contact" class="button">Get in Touch</a>
            </div>
        </div>
        <div class="right-column">
            <Image src={WorkImage} alt="Coffee and laptop" class="cta-image" />

            <div class="right-column-content">
                <h3>Connect With Me</h3>

                <div class="social-links">

                    <a 
                        href="https://github.com/f-mousecop"
                        target="_blank" 
                        aria-label="GitHub" 
                    >
                        <Icon name="mdi:github" />
                    </a>

                    <a 
                        href="https://www.linkedin.com/in/charles-clark-261b13284/"
                        target="_blank" 
                        aria-label="LinkedIn" 
                    >
                        <Icon name="mdi:linkedin" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .banner {
        min-height: 48.79px;
        background-color: var(--color-secondary);
    }
    
    .hero {
        background-color: var(--color-primary);
        padding-block: var(--space-2xl);
    }

    .hero-inner {
        display: flex;
        align-items: center;
        gap: 3rem;
    }

    .hero-text {
        flex: 0 1 40%;
    }

    .hero-img {
        flex: 1 1 60%;
        overflow: hidden;
        border-radius: var(--radius-md);
    }

    .eyebrow {
        font-size: var(--text-sm);
        color: var(--color-highlight);
    }

    .hero-text h1 {
        color: var(--color-highlight);
    }

    .hero-text p {
        color: var(--color-surface);
    }


    .hero-ctas {
        display: flex;
        gap: 1rem;
    }

    .button {
        background-color: var(--color-accent);
        color: var(--color-background);
        transition: transform 0.5s ease, box-shadow 0.5s ease;
        font-size: var(--text-sm);
    }

    .button:hover {
        transform: scale(1.03);
        box-shadow: var(--shadow-lg);
    }

    .secondary {
        background-color: transparent;
        border: 2px solid var(--color-accent);
    }

    .secondary:hover {
        background-color: var(--color-accent);
    }

    .introduction {
        display: flex;
        gap: 3rem;
        align-items: center;
    }

    .intro-img {
        flex: 0 1 40%;
        overflow: hidden;
        border-radius: var(--radius-md);
    }

    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .intro-text {
        flex: 1 1 60%;
    }

    #what-i-do {
        background-color: var(--color-primary);
        padding-block: var(--space-xl);
    }

    .divider {
        border: 2px solid var(--color-highlight);
    }

    .work-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        align-items: stretch;
        padding: 0.5rem 0;
    }

    .work-cards h3 {
        color: var(--color-surface);
    }

    .work-cards p {
        color: var(--color-background);
    }


    .featured-work {
        text-align: center;
    }

    .featured-work-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        align-items: stretch;
        padding: 0.5rem 0;
    }

    #call-to-action {
        background-color: var(--color-primary);
    }

    .call-to-action {
        display: flex;
        gap: 1rem;
        border: 1px solid var(--color-accent);
        padding: 0;
    }

    .left-column {
        flex: 0 1 50%;
        padding: 1rem;
        align-content: center;
    }


    .left-column h2 {
        color: var(--color-highlight);
    }

    .left-column p, 
    .left-column li {
        color: var(--color-surface);
    }

    .left-column .button {
        background-color: var(--color-surface);
        color: var(--color-text);
    }

    .cta-button {
        text-align: center;
    }


    .right-column {
        position: relative;
        flex: 1 1 50%;

        min-height: 400px;
        overflow: hidden;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .right-column :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Dark overlay */
    .right-column::after {
        content: "";
        position: absolute;
        inset: 0;

        background: rgba(0, 0, 0, 0.5);
    }

    /* Content above both image and overlay */
    .right-column-content {
        position: relative;
        z-index: 1;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;

        text-align: center;
        color: var(--color-surface);
    }

    .right-column-content h3 {
        color: var(--color-highlight);
        margin: 0;
    }

    .social-links {
        display: flex;
        gap: 1rem;
        font-size: 2.5rem;
    }

    .social-links a {
        background-color: var(--color-accent);
        color: var(--color-surface);
        border-radius: var(--radius-md);
        padding: 0.3rem;
        transition: opacity 0.5s ease;
    }

    .social-links a:hover {
        opacity: 0.7;
    }

    @media (max-width: 1023px) {
        .featured-work-cards {
            grid-template-columns: repeat(4, 1fr);
        }

        .featured-work-cards > :global(*) {
            grid-column: span 2;
        }

        .featured-work-cards > :global(:last-child) {
            grid-column: 2 / span 2;
        }
    }

    @media (max-width: 768px) {
        .hero-inner {
            flex-direction: column;
        }

        .hero-text,
        .hero-img {
            width: 100%;
        }

        .introduction {
            flex-direction: column;
        }

        .work-cards {
            grid-template-columns: 1fr;
        }

        .featured-work-cards {
            grid-template-columns: 1fr;
        }

        .featured-work-cards > :global(*) {
            grid-column: auto;
        }

        .featured-work-cards > :global(:last-child) {
            grid-column: auto;
        }

        .call-to-action {
            flex-direction: column;
        }
    }
</style>