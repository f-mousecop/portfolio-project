---
import { Image } from "astro:assets";

export interface Props {
    image: ImageMetadata;
    alt: string;
    title?: string;
    href?: string;
    description?: string;

    maxHeight?: string;
    marginBottom?:string;
    backgroundColor?:string;
}

const {
    image,
    alt,
    title,
    href,
    description,
    maxHeight, marginBottom = "0",
    backgroundColor = "var(--color-surface)"
} = Astro.props;
---

<article class="project-card">
    
    <div class="project-content">
        <h3>{title}</h3>

        <slot />

    </div>
        
    <a href={href} class="project-image">
        <Image src={image} alt={alt} />
    </a>

    <div class="project-content">
        {description && <p>{description}</p>}

        <a href={href} class="button">View Project</a>
    </div>
</article>

<style define:vars={{maxHeight, marginBottom, backgroundColor}}>
    .project-card {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        background: var(--backgroundColor);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        margin-bottom: var(--marginBottom);
        padding: 1rem;
        height: 100%;
        transition: 
            transform 0.5s ease,
            box-shadow 0.5s ease;
        will-change: transform;
    }

    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .project-image {
        display: block;
        width: 100%;
        overflow: hidden;
        border-radius: var(--radius-lg);
        aspect-ratio: 4 / 3;
    }

    .project-image :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .project-content {
        flex: 1;
        min-width: 0;
    }

    .project-content h3, p {
        color: var(--color-surface);
    }

    .button {
        background-color: var(--color-accent);
        color: var(--color-surface);
    }
</style>