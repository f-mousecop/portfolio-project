---
import { Image } from "astro:assets";

export interface Props {
    image: ImageMetadata;
    alt: string;
    title?: string;
    href?: string;
    description?: string;

    maxHeight?: string;
    marginBottom?:string;
    backgroundColor?:string;
}

const {
    image,
    alt,
    title,
    href,
    description,
    maxHeight, marginBottom = "0",
    backgroundColor = "var(--color-surface)"
} = Astro.props;
---

<article class="project-card">
    
    <div class="project-content">
        <div class="project-content-inner">
            <h3>{title}</h3>
    
            <slot />
            
            <div class="project-image">
                <Image src={image} alt={alt} />
            </div>
        <hr style="border: 1px solid var(--color-highlight); border-radius: var(--radius-md); width: 100%;">

    
            {description && <p>{description}</p>}
    
        </div>
        <a href={href} class="button">View Project</a>
    </div>
</article>

<style define:vars={{maxHeight, marginBottom, backgroundColor}}>
    .project-card {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-width: 0;
        background: var(--backgroundColor);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        margin-bottom: var(--marginBottom);
        padding: 1rem;
        height: 100%;
        transition: 
            transform 0.5s ease,
            box-shadow 0.5s ease;
        will-change: transform;
    }

    .project-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1;
        min-width: 0;
    }

    .project-content-inner {
        display: flex;
        flex-direction: column;
        min-width: 0;
        gap: 1rem;
        border: 2px solid var(--color-accent);
        border-radius: var(--radius-lg);
        padding: 0.7rem;
        margin-bottom: 1rem;
    }


    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .project-image {
        display: block;
        width: 100%;
        overflow: hidden;
        border-radius: var(--radius-lg);
        aspect-ratio: 4 / 3;
    }

    .project-image :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    

    .project-content h3, 
    .project-content p {
        color: var(--color-surface);
        margin-bottom: 0;
    }

    .button {
        align-self: center;
        margin-top: auto;
        background-color: var(--color-secondary);
        color: var(--color-surface);
        transition: 
            transform 0.5s ease,
            box-shadow 0.5s ease;
    }

    .button:hover {
        transform: scale(1.03);
        box-shadow: var(--shadow-lg);
    }
</style>