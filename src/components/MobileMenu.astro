---
import Nav from "./Nav.astro";
import { Icon } from 'astro-icon/components'
import { Image } from "astro:assets";
import LightLogo from '../assets/Light-logo.svg';
---

<div id="mobile-menu" class="mobile-menu-drawer">
    <nav class="mobile-nav">
        <Icon name="mdi:hamburger-close" id="menu-drawer-toggle" class="mobile-only" />
        <Nav showLogo={false} />
    </nav>
</div>

<script>
    document.addEventListener('astro:page-load', () => {
        const toggleBtn = document.getElementById('menu-drawer-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
    
        toggleBtn?.addEventListener('click', () => {
            mobileMenu?.classList.toggle('open');
            console.log("Clicked toggle button, toggling mobile menu");
        });
    });
</script>

<style>
    .mobile-menu-drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: 250px;
        height: 100vh;
        background-color: var(--color-border);
        box-shadow: -2px 0 5px rgba(0, 0, 0, 0.1);
        padding: 2rem;
        z-index: 100;
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        will-change: transform;
    }
    
    .mobile-only {
        position: absolute;
        background: none;
        border: none;
        right: 20px;
        top: 20px;
        font-size: 2.5em;
        color: var(--color-accent);
    }

    /* When the open class is added via js */
    .mobile-menu-drawer.open {
        transform: translateX(0);
    }
</style>