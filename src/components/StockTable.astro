---
// Inject multiple rows and columns of HTML contennt using slot="" attributes to specify the header and body content
import CustomTable from './CustomTable.astro';
---

<CustomTable>
    <Fragment slot="header"> <!-- pass table header content here -->
        <tr><th>Product Name</th><th>Stock units</th></tr>
    </Fragment>

    <Fragment slot="body">
        <tr><td>Flip-flops</td><td>64</td></tr>
        <tr><td>Boots</td><td>32</td></tr>
        <tr><td>Sneakers</td><td class="text-red-500">0</td></tr>
    </Fragment>
</CustomTable>